@{
    Layout = "~/Views/Shared/_LayoutHome.cshtml"; // hoặc relative path phù hợp
}
@{
    ViewData["Title"] = "Nhận lấy Voucher";
}

@model EXE_FAIEnglishTutor.Models.User

<!-- Page Content  -->
<div id="content" class="p-4 p-md-5 home">

    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container-fluid">

            <!-- Nút ẩn/hiện sidebar -->
            <button type="button" id="sidebarCollapse" class="btn btn-sidebar-custom">
                <i class="fa fa-bars"></i>
                <span class="sr-only">Ẩn/Hiện menu</span>
            </button>

            <!-- Nút hiện menu trên thiết bị nhỏ -->
            <button class="btn btn-dark d-inline-block d-lg-none ml-auto" type="button" data-toggle="collapse"
                    data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false"
                    aria-label="Ẩn/Hiện thanh điều hướng">
                <i class="fa fa-bars"></i>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="nav navbar-nav ml-auto">

                    @* Các mục tạm ẩn
                <li class="nav-item active">
                    <a class="nav-link" href="home.html">Trang chủ</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Giới thiệu</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Danh mục</a>
                </li> *@

                    @if (User.Identity.IsAuthenticated)
                    {
                        // Lấy thông tin người dùng từ cookie
                        var fullName = User.Identity.Name;
                        var avatarUrl = User.FindFirst("Avatar")?.Value;

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle nav-link-avatar" href="#" id="avatarDropdown" role="button"
                               data-toggle="dropdown" aria-expanded="false">
                                <div class="nav-img">
                                    <img src="@avatarUrl" alt="Ảnh đại diện" class="img-fluid" style="border-radius: 50%;">
                                </div>
                            </a>

                            <div class="menu-items dropdown-menu dropdown-menu-right" aria-labelledby="avatarDropdown">
                                <div class="menu-title">
                                    <h6 class="dropdown-header">Xin chào, <span>@fullName</span></h6>
                                </div>

                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" asp-area="Mentee" asp-controller="Profile" asp-action="index">
                                    <i class="bi bi-person-circle"></i> Xem hồ sơ
                                </a>

                                @if (User.Identity.IsAuthenticated)
                                {
                                    @if (User.IsInRole("admin"))
                                    {
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="index">
                                            <i class="bi bi-speedometer2"></i> Bảng điều khiển
                                        </a>
                                    }
                                }

                                <div class="dropdown-divider"></div>
                                <a id="logout-link" class="dropdown-item text-danger" href="#">
                                    <i class="bi bi-box-arrow-right"></i> <span id="logoutOption">Đăng xuất</span>
                                </a>

                                <form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post" style="display: none;"></form>
                            </div>
                        </li>
                    }
                    else
                    {
                        <a class="btn-login-custom btn" asp-controller="Account" asp-action="Login">Đăng nhập ngay</a>
                    }

                </ul>
            </div>
        </div>
    </nav>


    <!-- FAI MEMBER -->
    <div class="container text-center mt-5">
        <div class="fai-member-section">
            <h2 class="highlight">Thử Thách Âm Nhạc Thành Viên FAI</h2>
            <p style="color: black">Xem và nghe các đoạn nhạc dưới đây để đoán tên bài hát! Gửi câu trả lời của bạn trên <a href="[Your_Facebook_Link]" target="_blank" class="highlight-nova">trang Facebook</a> của chúng tôi để có cơ hội nhận voucher độc quyền!</p>
            <div class="pricing-container">
                <!-- Music Clip 1 -->
                <div class="pricing-card card-wrapper">
                    <div class="plan-title">Bài hát 1</div>
                    <iframe width="100%" height="200" src="https://www.youtube.com/embed/RhU9MZ98jxo?start=0&end=30&modestbranding=1&controls=0&rel=0" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                    <div class="features">
                        <li>Hãy lắng nghe kỹ để nhận diện bài hát.</li>
                        <li>Nhấn vào nút bên dưới để gửi câu trả lời của bạn!</li>
                    </div>
                    <a href="[Your_Facebook_Link]" target="_blank" class="btn btn-pay">Gửi câu trả lời</a>
                </div>

                <!-- Music Clip 2 -->
                <div class="pricing-card card-wrapper">
                    <div class="plan-title">Bài hát 2</div>
                    <iframe width="100%" height="200" src="https://www.youtube.com/embed/egtD5GfAh58?start=0&end=30&modestbranding=1&controls=0&rel=0" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                    <div class="features">
                        <li>Bạn có thể đoán được giai điệu này không?</li>
                        <li>Tham gia thử thách trên Facebook!</li>
                    </div>
                    <a href="[Your_Facebook_Link]" target="_blank" class="btn btn-pay">Gửi câu trả lời</a>
                </div>
            </div>
        </div>
    </div>






</div>


@section Scripts {
    <script src="~/js/handle-sidbar/home-sidebar.js"></script>
    <style>

        body {
            background-color: #0f111a;
            color: #ffffff;
            font-family: "Segoe UI", sans-serif;
            margin: 0;
            padding: 0;
        }

        .pricing-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 30px;
            margin-top: 40px;
        }

        .pricing-card {
            background: linear-gradient(to top, #e2e6e6, #fff);
            color: #1a1a1a;
            border-radius: 20px;
            padding: 20px;
            width: 320px;
            height: 450px; /* Đặt chiều cao cố định để đồng đều */
            display: flex;
            flex-direction: column;
            justify-content: space-between; /* giữ mọi thứ giãn đều theo chiều dọc */
            box-shadow: 0 0 15px #00000060;
            transition: transform 0.3s;
        }

            .pricing-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 0 20px rgba(0, 0, 0, 0.4);
            }

        .featured {
            position: absolute;
            top: 0;
            right: 0;
            background: gold;
            color: #000;
            font-size: 13px;
            font-weight: bold;
            padding: 4px 12px;
            border-top-right-radius: 20px;
            border-bottom-left-radius: 10px;
        }

        .plan-title {
            font-size: 1.6rem;
            font-weight: bold;
            margin-bottom: 10px;
            text-align: center;
            color: #1a1a1a;
        }

        .price {
            font-size: 1.4rem;
            font-weight: bold;
            text-align: center;
            margin-bottom: 15px;
        }

        .features {
            list-style: none;
            padding-left: 0;
            font-size: 1.05rem;
        }

            .features li {
                margin-bottom: 10px;
            }

        .btn-pay {
            width: 100%;
            background-color: #ff6600;
            color: #fff;
            font-size: 1.1rem;
            font-weight: 600;
            padding: 10px;
            border-radius: 8px;
            border: none;
            margin-top: auto;
            cursor: pointer;
            transition: background-color 0.2s ease-in-out;
        }

            .btn-pay:hover {
                background-color: #e55b00;
            }

        .avatar-glow {
            border-radius: 50%;
            border: 4px solid red;
            box-shadow: 0 0 15px red;
            width: 80px;
            height: 80px;
            object-fit: cover;
            margin-top: 10px;
        }

        .highlight {
            color: #e55b00;
            font-size: 2rem;
            font-weight: bold;
        }

        .highlight-nova {
            color: red;
            font-weight: bold;
            text-decoration: underline;
        }

        .card-wrapper {
            position: relative;
        }

    </style>


    <script>
               $(document).ready(function () {
            $("#voucherBtn").click(function (e) {
                const isAuthenticated = @User.Identity.IsAuthenticated.ToString().ToLower();
                const isPaidMember = @(ViewBag.userCheckMember == true ? "true" : "false");
                if (!isAuthenticated) {
                    e.preventDefault();
                    if (confirm("Bạn cần đăng nhập để tham gia thử thách âm nhạc. Đăng nhập ngay?")) {
                        window.location.href = "/Account/Login";
                    }
                } else if (!isPaidMember) {
                    e.preventDefault();
                    if (confirm("Bạn cần nâng cấp gói thành viên để tham gia. Nâng cấp ngay?")) {
                        window.location.href = "/Payment/index";
                    }
                } else {
                    window.location.href = "/Voucher/MusicVoucher";
                }
            });
        });
    </script>




}

