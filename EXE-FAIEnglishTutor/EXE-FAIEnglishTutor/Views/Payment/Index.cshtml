@section Scripts {
    <script src="~/js/handle-sidbar/home-sidebar.js"></script>
    <style>

        body {
            font-family: 'Open Sans', sans-serif;
            margin: 0;
            padding: 0;
        }


        body {
            background-color: #0f111a;
            color: #ffffff;
            font-family: "Segoe UI", sans-serif;
        }

        .pricing-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
            margin-top: 40px;
        }

        .pricing-card {
            background: linear-gradient(to top, #e2e6e6, #fff); /*f1faee f5f2ee*/
            color: #1a1a1a; /* nên đổi màu chữ nếu nền quá sáng */
            border-radius: 20px;
            padding: 20px;
            width: 300px;
            height: 350px;
            box-shadow: 0 0 15px #00000060;
            transition: transform 0.3s;
        }

            .pricing-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 0 15px rgba(0, 0, 0, 0.3);
            }

        .featured {
            position: absolute;
            top: 0;
            right: 0;
            background: gold;
            color: #000;
            font-size: 12px;
            padding: 3px 10px;
            border-top-right-radius: 20px;
            border-bottom-left-radius: 10px;
        }

        .plan-title {
            font-size: 1.5rem;
            font-weight: bold;
            margin-bottom: 10px;
            text-align: center;
        }

        .price {
            font-size: 1.2rem;
            text-align: center;
            margin-bottom: 20px;
        }

        .features {
            list-style: none;
            padding: 0;
        }

            .features li {
                margin-bottom: 10px;
            }

        .btn-pay {
            width: 100%;
            background-color: orange;
            border: none;
            margin-top: 15px;
        }

        .avatar-glow {
            border-radius: 50%;
            border: 4px solid magenta;
            box-shadow: 0 0 15px magenta;
            width: 80px;
            height: 80px;
            object-fit: cover;
            margin-top: 10px;
        }

          /* Hiệu ứng viền bảy sắc cầu vồng (Nhẹ nhàng hơn) */
        @@keyframes rainbow {
            0% { box-shadow: 0 0 10px rgba(255, 0, 0, 0.3); border-color: rgba(255, 0, 0, 0.4); }
            14% { box-shadow: 0 0 10px rgba(255, 127, 0, 0.3); border-color: rgba(255, 127, 0, 0.4); }
            28% { box-shadow: 0 0 10px rgba(255, 255, 0, 0.3); border-color: rgba(255, 255, 0, 0.4); }
            42% { box-shadow: 0 0 10px rgba(0, 255, 0, 0.3); border-color: rgba(0, 255, 0, 0.4); }
            56% { box-shadow: 0 0 10px rgba(0, 0, 255, 0.3); border-color: rgba(0, 0, 255, 0.4); }
            70% { box-shadow: 0 0 10px rgba(75, 0, 130, 0.3); border-color: rgba(75, 0, 130, 0.4); }
            84% { box-shadow: 0 0 10px rgba(148, 0, 211, 0.3); border-color: rgba(148, 0, 211, 0.4); }
            100% { box-shadow: 0 0 10px rgba(255, 0, 0, 0.3); border-color: rgba(255, 0, 0, 0.4); }
        }

        .card-wrapper {
            position: relative;
        }

        .rainbow-card {
            border: 2px solid rgba(255,0,0,0.4);
            animation: rainbow 5s linear infinite;
            box-sizing: border-box;
        }

        /* Bổ sung CSS cho nút Donate (mượn từ Test Online) */
        .btn-test-online {
            display: inline-block;
            background-color: orange !important;
            color: white !important;
            /* font-size: 16px; */
            font-weight: bold;
            padding: 6px 20px;
            border: none;
            border-radius: 6px;
            text-decoration: none;
            text-transform: uppercase;
            transition: 0.3s ease-in-out;
            box-shadow: 0px 3px 6px rgba(0, 0, 0, 0.2);
            background: url(/images/effect-1.gif);
            background-size: cover;
            width: 100%;
            margin-top: 12px;
        }

        .btn-test-online:hover {
            transform: scale(1.05);
            color: white !important;
            text-decoration: none;
        }

        /* Hiệu ứng thả lồng đèn trung thu */
        .lantern {
            position: fixed;
            bottom: -50px;
            z-index: 9999;
            animation: floatUp 6s linear forwards;
            pointer-events: none;
            opacity: 0.9;
        }
        
        @@keyframes floatUp {
            0% { transform: translateY(0) rotate(0deg); opacity: 1; }
            100% { transform: translateY(-120vh) rotate(360deg); opacity: 0; }
        }
    </style>

    <!-- Thêm thư viện pháo hoa canvas-confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <script>
        window.onload = function() {
            // 1. Hiệu ứng pháo hoa (Bắn trong 3 giây đầu tiên)
            var duration = 3 * 1000;
            var end = Date.now() + duration;

            (function frame() {
                // Bắn từ bên trái
                confetti({
                    particleCount: 5,
                    angle: 60,
                    spread: 55,
                    origin: { x: 0 },
                    colors: ['#ff0000', '#00ff00', '#0000ff', '#ffff00', '#ff00ff']
                });
                // Bắn từ bên phải
                confetti({
                    particleCount: 5,
                    angle: 120,
                    spread: 55,
                    origin: { x: 1 },
                    colors: ['#ff0000', '#00ff00', '#0000ff', '#ffff00', '#ff00ff']
                });

                if (Date.now() < end) {
                    requestAnimationFrame(frame);
                }
            }());

            // 2. Hiệu ứng thả lồng đèn Trung Thu (Chạy liên tục vô tận)
            const emojis = ['🏮', '🌕', '✨', '🐰', '🥮'];
            
            setInterval(() => {
                const lantern = document.createElement('div');
                lantern.className = 'lantern';
                lantern.innerText = emojis[Math.floor(Math.random() * emojis.length)];
                
                // Xuất hiện ngẫu nhiên theo chiều ngang
                lantern.style.left = Math.random() * 95 + 'vw';
                // Kích thước ngẫu nhiên
                lantern.style.fontSize = (Math.random() * 20 + 20) + 'px';
                // Tốc độ bay ngẫu nhiên (4-7 giây)
                lantern.style.animationDuration = (Math.random() * 3 + 4) + 's'; 
                
                document.body.appendChild(lantern);
                
                // Xóa DOM sau khi bay xong để không nặng máy
                setTimeout(() => {
                    lantern.remove();
                }, 7000);
            }, 250); // Cứ 250ms thả một cái, không bao giờ dừng
        };

        const payLink = document.getElementById('pay-link');
        if (payLink) {
            payLink.addEventListener('click', function (event) {
                event.preventDefault();
                // Kiểm tra trạng thái đăng nhập
                const isAuthenticated = @Json.Serialize(User.Identity.IsAuthenticated);
                if (!isAuthenticated) {
                  
                    Swal.fire({
                        title: 'OMG! Có rắc rối rồi.',
                        text: "Bạn phải đăng nhập để thực hiện yêu cầu này.",
                        icon: 'info',
                        confirmButtonColor: '#ed782b',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'OK',
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = '@Url.Action("Login", "Account")';
                        }
                    });
                } else {
                    // Nếu đã đăng nhập, submit form ngay
                    document.getElementById('payForm').submit();
                }
            });
        }
    </script>




}

