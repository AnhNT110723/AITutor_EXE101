    <style>

        .timeline-section {
            background-image: url('../images/homepage/learnai.webp');
            background-repeat: no-repeat;
            background-position: center;
            background-size: cover;
            position: relative;
        }

        .timeline-container .vertical-scrollable-timeline {
            list-style-type: none;
            position: relative;
            padding-left: 0;
        }

            .timeline-container .vertical-scrollable-timeline .list-progress {
                width: 8px;
                height: 87%;
                background-color: #e96d08;
                position: absolute;
                left: 52px;
                top: 0;
                overflow: hidden;
            }

                .timeline-container .vertical-scrollable-timeline .list-progress .inner {
                    position: absolute;
                    right: 0;
                    bottom: 0;
                    height: 100%;
                    background-color: #f4a261;
                    width: 100%;
                }

            .timeline-container .vertical-scrollable-timeline li {
                position: relative;
                padding: 20px 0px 65px 145px;
            }

                .timeline-container .vertical-scrollable-timeline li:last-child {
                    padding-bottom: 0;
                }

                .timeline-container .vertical-scrollable-timeline li p {
                    line-height: 40px;
                }

                    .timeline-container .vertical-scrollable-timeline li p:last-child {
                        margin-bottom: 0;
                    }

                .timeline-container .vertical-scrollable-timeline li .icon-holder {
                    position: absolute;
                    left: 0;
                    top: 0;
                    width: 104px;
                    height: 104px;
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    background-color: #f4a261;
                    border-radius: 50%;
                    z-index: 1;
                    transition: 0.4s all;
                }

                    .timeline-container .vertical-scrollable-timeline li .icon-holder::before {
                        content: "";
                        width: 80px;
                        height: 80px;
                        border: 4px solid #fff;
                        position: absolute;
                        background-color: #f4a261;
                        border-radius: 50%;
                        z-index: -1;
                        transition: 0.4s all;
                    }

                    .timeline-container .vertical-scrollable-timeline li .icon-holder i {
                        font-size: 25px;
                        color: #fff;
                    }

                .timeline-container .vertical-scrollable-timeline li::before {
                    content: "";
                    position: absolute;
                    height: 100%;
                    width: 8px;
                    background-color: transparent;
                    left: 52px;
                    z-index: 0;
                }

                .timeline-container .vertical-scrollable-timeline li.active .icon-holder {
                    background-color: #d56604;
                }

                    .timeline-container .vertical-scrollable-timeline li.active .icon-holder::before {
                        background-color: #d56604;
                    }

        .section-overlay {
            background-image: linear-gradient(15deg, #423b35 0%, #2f2816 100%);
            position: absolute;
            top: 0;
            left: 0;
            pointer-events: none;
            width: 100%;
            height: 100%;
            opacity: 0.85;
        }

            .section-overlay + .container-fluid {
                position: relative;
            }


        #google_translate_element {
            margin-top: 14px;
        }


        .goog-logo-link {
            display: none !important;
        }


        .goog-te-gadget span {
            display: none;
        }


        .goog-te-combo {
            padding: 4px 8px;
            font-size: 14px;
            border-radius: 6px;
            border: 1px solid #ccc;
            background-color: white;
            color: #333;
        }

        .goog-te-gadget {
            font-size: 0px !important;
        }

            .goog-te-gadget .goog-te-combo {
                width: 140px !important;
            }

        .pricing-section .card {
            min-height: 480px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            border-radius: 18px;
            border: none;
            box-shadow: 0 4px 24px rgba(0,0,0,0.08);
            transition: transform 0.2s;
        }
        .pricing-section .card:hover {
            transform: translateY(-8px) scale(1.03);
            box-shadow: 0 8px 32px rgba(0,0,0,0.15);
        }
        .pricing-section .featured {
            font-weight: bold;
            letter-spacing: 1px;
            font-size: 1.1rem;
            padding: 6px 0;
            border-radius: 8px;
            margin-bottom: 10px;
        }
        .pricing-section .plan-title {
            font-size: 1.4rem;
            font-weight: 700;
            margin-bottom: 8px;
        }
        .pricing-section .price {
            font-size: 2rem;
            font-weight: 700;
            color: #e96d08;
        }
        .pricing-section .features {
            font-size: 1.05rem;
        }
        .pricing-section .btn-pay {
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            padding: 10px 0;
            width: 100%;
            transition: background 0.2s, color 0.2s;
        }
        /* FAI GUEST card (FREE TRIAL) */
        .pricing-section .col-lg-5:first-child .card {
            background: linear-gradient(135deg, #fff7ed 0%, #ffe0c1 100%);
            color: #e96d08;
            border: 2px solid #f4a261;
        }
        .pricing-section .col-lg-5:first-child .card .featured {
            background: #f4a261;
            color: #fff;
        }
        .pricing-section .col-lg-5:first-child .card .plan-title {
            color: #e96d08;
        }
        .pricing-section .col-lg-5:first-child .card .price {
            color: #e96d08;
        }
        .pricing-section .col-lg-5:first-child .card .btn-pay {
            background: #e96d08;
            color: #fff;
            border: none;
        }
        .pricing-section .col-lg-5:first-child .card .features li {
            color: #e96d08;
        }
        /* FAI MEMBER card (right) */
        .pricing-section .col-lg-5:last-child .card {
            background: linear-gradient(135deg, #f4a261 0%, #e96d08 100%);
            color: #fff;
        }
        .pricing-section .col-lg-5:last-child .card .featured {
            background: #fff;
            color: #e96d08;
        }
        .pricing-section .col-lg-5:last-child .card .plan-title {
            color: #fff;
        }
        .pricing-section .col-lg-5:last-child .card .price {
            color: #fff;
        }
        .pricing-section .col-lg-5:last-child .card .btn-pay {
            background: #fff;
            color: #e96d08;
            border: none;
        }
        .pricing-section .col-lg-5:last-child .card .features li {
            color: #fff;
        }
        @@media (max-width: 991px) {
            .pricing-section .col-lg-5 {
                margin-bottom: 24px;
            }
        }
        .pricing-section .row.justify-content-center {
            gap: 32px;
        }
        .pricing-section .col-lg-5 {
            margin-left: 0;
            margin-right: 0;
        }
        /* Voucher Section Styles */
        .voucher-section {
            background: linear-gradient(135deg, #fff7ed 0%, #ffe0c1 100%);
            padding: 60px 0;
        }

            .voucher-section .card {
                min-height: 300px;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                border-radius: 18px;
                border: none;
                box-shadow: 0 4px 24px rgba(0,0,0,0.08);
                transition: transform 0.2s;
                background: linear-gradient(135deg, #f4a261 0%, #e96d08 100%);
                color: #fff;
            }

                .voucher-section .card:hover {
                    transform: translateY(-8px) scale(1.03);
                    box-shadow: 0 8px 32px rgba(0,0,0,0.15);
                }

            .voucher-section .voucher-title {
                font-size: 1.8rem;
                font-weight: 700;
                margin-bottom: 12px;
                color: #fff;
            }

            .voucher-section .voucher-text {
                font-size: 1.1rem;
                margin-bottom: 20px;
                color: #fff;
            }

            .voucher-section .btn-voucher {
                font-size: 1.1rem;
                font-weight: 600;
                border-radius: 8px;
                padding: 10px 0;
                width: 100%;
                background: #fff;
                color: #e96d08;
                border: none;
                transition: background 0.2s, color 0.2s;
            }

                .voucher-section .btn-voucher:hover {
                    background: #e96d08;
                    color: #fff;
                }
        @@media (min-width: 992px) {
            .pricing-section .row.justify-content-center {
                justify-content: center;
            }
            .pricing-section .col-lg-5 {
                flex: 0 0 40%;
                max-width: 40%;
            }
        }

        h6 {
            color: khaki;
        }
    </style>
</head>

