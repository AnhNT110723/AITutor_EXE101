@section Scripts {
    <script src="~/js/handle-sidbar/home-sidebar.js"></script>
    <script src="~/js/ai-chat-utils.js"></script>
    <style>
        body { font-family: 'Open Sans', sans-serif; margin: 0; padding: 0; }

        /* ===== Toggle Button ===== */
        .chat-toggle-btn {
            position: fixed; bottom: 24px; right: 24px;
            width: 58px; height: 58px;
            background: linear-gradient(135deg, #ff6701, #ff8c00);
            border-radius: 50%; border: none; color: white; font-size: 22px;
            cursor: pointer; box-shadow: 0 4px 16px rgba(255,103,1,0.45);
            z-index: 1050; transition: transform 0.25s, box-shadow 0.25s;
            display: flex; align-items: center; justify-content: center;
        }
        .chat-toggle-btn:hover { transform: scale(1.1); box-shadow: 0 6px 20px rgba(255,103,1,0.6); }

        /* ===== Chat Popup ===== */
        .chat-popup {
            display: none; position: fixed; bottom: 94px; right: 24px;
            width: 340px; height: 480px; background: #fff;
            border-radius: 16px; box-shadow: 0 8px 32px rgba(0,0,0,0.18);
            z-index: 1040; overflow: hidden; flex-direction: column;
            transition: width 0.3s ease, height 0.3s ease;
        }
        .chat-popup.chat-popup-on { display: flex; }
        .chat-popup.chat-expanded { width: 480px; height: 620px; }

        /* ===== Header ===== */
        .popup-head {
            background: linear-gradient(135deg, #ff6701, #ff4500);
            color: white; padding: 10px 14px;
            display: flex; justify-content: space-between; align-items: center; flex-shrink: 0;
        }
        .popup-head-left { display: flex; align-items: center; gap: 10px; }
        .bot-avatar-ring {
            width: 40px; height: 40px; border-radius: 50%;
            border: 2px solid rgba(255,255,255,0.7);
            background: rgba(255,255,255,0.15);
            display: flex; align-items: center; justify-content: center; flex-shrink: 0;
        }
        .bot-info { display: flex; flex-direction: column; }
        .bot-name { font-weight: 700; font-size: 14px; line-height: 1.2; }
        .bot-status { font-size: 11px; opacity: 0.9; display: flex; align-items: center; gap: 4px; }
        .status-dot { width: 7px; height: 7px; background: #7fff7f; border-radius: 50%; animation: pulse-dot 2s infinite; }
        @@keyframes pulse-dot { 0%,100%{opacity:1} 50%{opacity:0.4} }
        .popup-head-actions { display: flex; gap: 6px; }
        .chat-header-btn {
            background: rgba(255,255,255,0.15); border: none; color: white;
            width: 30px; height: 30px; border-radius: 50%; cursor: pointer;
            font-size: 13px; display: flex; align-items: center; justify-content: center; transition: background 0.2s;
        }
        .chat-header-btn:hover { background: rgba(255,255,255,0.3); }

        /* ===== Messages ===== */
        .popup-messages { flex: 1; overflow-y: auto; padding: 14px 12px; background: #f7f8fc; min-height: 0; scroll-behavior: smooth; }
        .direct-chat-msg { display: flex; align-items: flex-end; gap: 8px; margin-bottom: 12px; }
        .direct-chat-msg.user-msg { flex-direction: row-reverse; }
        .msg-avatar-sm {
            width: 28px; height: 28px; border-radius: 50%;
            background: linear-gradient(135deg, #ff6701, #ff4500); color: white;
            display: flex; align-items: center; justify-content: center; font-size: 12px; flex-shrink: 0;
        }
        .msg-content { max-width: 80%; }
        .direct-chat-text {
            background: #fff; border-radius: 16px 16px 16px 4px;
            padding: 9px 13px; font-size: 14px; line-height: 1.5;
            box-shadow: 0 1px 4px rgba(0,0,0,0.08); word-break: break-word;
        }
        .user-msg .direct-chat-text {
            background: linear-gradient(135deg, #ff6701, #ff8c00); color: white; border-radius: 16px 16px 4px 16px;
        }
        .direct-chat-timestamp { font-size: 11px; color: #aaa; margin-top: 3px; padding: 0 2px; }
        .user-msg .direct-chat-timestamp { text-align: right; }

        /* ===== Footer ===== */
        .popup-messages-footer { padding: 10px 12px; background: #fff; border-top: 1px solid #eee; flex-shrink: 0; }
        .input-container {
            display: flex; align-items: center; background: #f0f2f5;
            border-radius: 24px; padding: 6px 8px 6px 14px; gap: 8px;
            border: 1.5px solid transparent; transition: border-color 0.2s;
        }
        .input-container:focus-within { border-color: #ff6701; }
        .popup-messages-footer textarea {
            flex: 1; border: none; background: transparent; resize: none;
            font-size: 14px; outline: none; max-height: 100px; min-height: 22px; line-height: 1.5;
        }
        .send-btn {
            background: linear-gradient(135deg, #ff6701, #ff4500); border: none; color: white;
            width: 34px; height: 34px; border-radius: 50%; cursor: pointer; font-size: 14px;
            display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: transform 0.2s;
        }
        .send-btn:hover { transform: scale(1.08); }
        .send-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

        /* Google Translate */
        #google_translate_element { display:inline-block; border-radius:8px; padding:4px 8px; background-color:#f9f9f9; font-size:14px; }
        .goog-logo-link { display:none !important; }
        .goog-te-gadget span { display:none; }
        .goog-te-combo { padding:4px 8px; font-size:14px; border-radius:6px; border:1px solid #ccc; background-color:white; color:#333; }
    </style>

    <script>
        $(function () {
            var pastedImageBase64 = null;

            // Handle image paste
            $('#status_message').on('paste', function (e) {
                var items = (e.originalEvent || e).clipboardData.items;
                for (var index in items) {
                    var item = items[index];
                    if (item.kind === 'file' && item.type.startsWith('image/')) {
                        var blob = item.getAsFile();
                        var reader = new FileReader();
                        reader.onload = function (event) {
                            pastedImageBase64 = event.target.result;
                            $('#chat-image-preview').attr('src', pastedImageBase64);
                            $('#chat-image-preview-container').show();
                        };
                        reader.readAsDataURL(blob);
                    }
                }
            });

            $('#chat-image-remove').click(function () {
                pastedImageBase64 = null;
                $('#chat-image-preview').attr('src', '');
                $('#chat-image-preview-container').hide();
            });

            // Open / Close
            $('#addClass').click(function () {
                $('#qnimate').toggleClass('chat-popup-on');
                if ($('#qnimate').hasClass('chat-popup-on')) $('#status_message').focus();
            });
            $('#removeClass').click(function () {
                $('#qnimate').removeClass('chat-popup-on chat-expanded');
            });

            // Expand / Collapse
            $('#expandChat').click(function () {
                $('#qnimate').toggleClass('chat-expanded');
                var icon = $(this).find('i');
                if ($('#qnimate').hasClass('chat-expanded')) {
                    icon.removeClass('fa-expand-alt').addClass('fa-compress-alt');
                } else {
                    icon.removeClass('fa-compress-alt').addClass('fa-expand-alt');
                }
            });

            // Auto-resize textarea
            $('#status_message').on('input', function () {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 100) + 'px';
            });

            // Enter to send, Shift+Enter = newline
            $('#status_message').on('keydown', function (e) {
                if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); $('#send-button').click(); }
            });

            // Send message
            $('#send-button').on('click', function () {
                var message = $('#status_message').val().trim();
                if (!message && !pastedImageBase64) return;

                if (pastedImageBase64) {
                    var imgHtml = "<div style='margin-top: 8px;'><img src='" + pastedImageBase64 + "' style='max-width: 100%; border-radius: 8px;'/></div>";
                    appendUserMessage((message ? escapeHtml(message) : '') + imgHtml);
                } else {
                    appendUserMessage(escapeHtml(message));
                }

                var imageToSend = pastedImageBase64;
                $('#status_message').val('').css('height', 'auto');
                pastedImageBase64 = null;
                $('#chat-image-preview-container').hide();
                $('#send-button').prop('disabled', true);
                scrollToBottom();

                // Typing indicator — dùng hàm từ ai-chat-utils.js
                showAITyping('chat-messages');
                scrollToBottom();

                $.post('/Chat/SendMessage', { message: message, imageBase64: imageToSend }, function (data) {
                    removeAITyping();
                    var reply = data.success ? data.response : (data.response || 'Có lỗi xảy ra.');
                    appendAIMessage(reply);
                }).fail(function () {
                    removeAITyping();
                    appendAIMessage('Có lỗi xảy ra khi gửi tin nhắn. Vui lòng thử lại.');
                }).always(function () {
                    $('#send-button').prop('disabled', false);
                    scrollToBottom();
                });
            });

            function appendUserMessage(htmlContent) {
                $('#chat-messages').append(`
                    <div class="direct-chat-msg user-msg">
                        <div class="msg-avatar-sm"><i class="fas fa-user"></i></div>
                        <div class="msg-content">
                            <div class="direct-chat-text">${htmlContent}</div>
                            <div class="direct-chat-timestamp">${getFormattedTime()}</div>
                        </div>
                    </div>`);
            }

            function appendAIMessage(text) {
                $('#chat-messages').append(`
                    <div class="direct-chat-msg ai-msg">
                        <div class="msg-avatar-sm"><i class="fas fa-robot"></i></div>
                        <div class="msg-content">
                            <div class="direct-chat-text">${text}</div>
                            <div class="direct-chat-timestamp">${getFormattedTime()}</div>
                        </div>
                    </div>`);
            }

            function escapeHtml(str) {
                return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
            }

            function scrollToBottom() {
                var c = document.getElementById('chat-container');
                if (c) c.scrollTop = c.scrollHeight;
            }
        });
    </script>
<script type="text/javascript">
        function googleTranslateElementInit() {
            new google.translate.TranslateElement(
                { pageLanguage: 'en' },
                'google_translate_element'
            );
        }
    </script>
    <script type="text/javascript" src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

